# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/reports

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# cursor
.cursor

# Markdown files
# Ignore all markdown files except README.md and developer documentation
*.md
!README.md

# Ignore nested markdown files but keep README.md and important developer docs
**/*.md
!**/README.md
# Keep important developer documentation (pertinent to future developers)
!docs/api/*.md
!docs/environment-variables.md
!docs/deployment-checklist.md
!docs/deployment-environments.md
!docs/monitoring-guide.md
!docs/*guide.md
!docs/*reference.md

# Phase-driven test files (not UI-driven tests)
# These are temporary phase-specific tests that shouldn't be committed
**/phase*-*.test.ts
**/phase*-*.test.tsx
**/phase*-unit-tests.ts
**/phase*-edge-cases.test.ts
**/phase*-load-testing.md
**/PHASE*-README.md
**/run-phase*-tests.sh

# SQL migration files
# Ignore migration SQL files (these are typically generated/applied remotely)
supabase/migrations/*.sql