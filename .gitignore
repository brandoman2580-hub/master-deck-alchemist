# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/reports

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# image migration cache (Supabase → AWS S3)
.image-migration-cache/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# cursor
.cursor

# Markdown — only README files are tracked by default.
# All other *.md files are ignored (including setup/planning docs).
*.md
!README.md
!**/README.md
!**/NOT_LIVE.md

# Local agent skill installs (npx skills) — do not commit
.agents/
# BEGIN docs-track
# Generated by scripts/sync-docs-gitignore.mjs — run: npm run docs:git-sync
/docs/**
!/docs/.tracked
!/docs/strategist-eval-matrix.md
!/docs/strategist-optimization-plan.md
# END docs-track

# Phase-driven test files (not UI-driven tests)
# These are temporary phase-specific tests that shouldn't be committed
**/phase*-*.test.ts
**/phase*-*.test.tsx
**/phase*-unit-tests.ts
**/phase*-edge-cases.test.ts
**/phase*-load-testing.md
**/PHASE*-README.md
**/run-phase*-tests.sh

# SQL migration files
# Most migration SQL is applied remotely; Facts Brain seeds are still
# asserted by Jest and must stay in git for CI.
supabase/migrations/*.sql
!supabase/migrations/*facts_brain*.sql
!supabase/migrations/*master_rank*.sql
