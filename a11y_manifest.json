{
  "version": "1.0",
  "project": "Master Deck Alchemist",
  "target_standard": "WCAG 2.1 AA",
  "last_updated": "2024-01-XX",
  "inventory_schema": {
    "component_name": {
      "type": "string",
      "description": "Component/page identifier (e.g., 'LoginForm', 'Navbar')",
      "required": true
    },
    "path": {
      "type": "string",
      "description": "File path relative to repo root (e.g., 'components/ui/login-form.tsx')",
      "required": true
    },
    "priority": {
      "type": "enum",
      "values": ["Critical", "High", "Medium", "Low"],
      "description": "Remediation priority based on user impact",
      "required": true
    },
    "owner": {
      "type": "string",
      "description": "Assigned engineer or team member",
      "required": false
    },
    "state": {
      "type": "enum",
      "values": ["untested", "in-progress", "fixed", "verified"],
      "description": "Current remediation state",
      "required": true,
      "default": "untested"
    },
    "notes": {
      "type": "string",
      "description": "Remediation notes, blockers, or context",
      "required": false
    },
    "wcag_criteria_violations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of WCAG success criteria violated (e.g., ['3.3.1', '4.1.3'])",
      "required": true
    },
    "automated_testable": {
      "type": "boolean",
      "description": "Whether violations can be detected via automated tools",
      "required": false,
      "default": true
    },
    "estimated_effort_hours": {
      "type": "number",
      "description": "Estimated remediation time in hours",
      "required": false
    }
  },
  "prioritized_backlog": [
