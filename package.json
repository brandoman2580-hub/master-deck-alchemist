{
  "name": "master-deck-alchemist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "start http://localhost:3000 & next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "docs:git-sync": "node scripts/sync-docs-gitignore.mjs",
    "docs:check": "node scripts/check-staged-docs.mjs",
    "a11y:inventory": "tsx scripts/generate-a11y-inventory.ts",
    "a11y:lint": "eslint . --ext .ts,.tsx --format json --output-file reports/eslint-a11y-report.json || true",
    "a11y:scan": "npm run a11y:axe && npm run a11y:pa11y && npm run a11y:lighthouse",
    "a11y:axe": "jest --testPathPattern=a11y --json --outputFile=reports/jest-a11y-results.json || true",
    "a11y:pa11y": "pa11y-ci --json > reports/pa11y-report.json || true",
    "a11y:lighthouse": "lhci autorun || true",
    "a11y:scan-full": "npm run build && npx start-server-and-test start http://localhost:3000 a11y:scan",
    "a11y:baseline": "mkdir -p baseline && cp reports/pa11y-report.json baseline/pa11y-baseline.json 2>/dev/null || true && cp reports/jest-a11y-results.json baseline/jest-a11y-baseline.json 2>/dev/null || true",
    "test": "jest --json --outputFile=reports/jest-results.json --runInBand && node scripts/generate-test-report.js",
    "test:unit": "npx jest --runInBand",
    "test:edge": "deno test --no-check --allow-read --allow-env --allow-net supabase/functions/recommendation-agent/tests/sanitization.test.ts supabase/functions/recommendation-agent/tests/json-extraction.test.ts",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "test:a11y": "jest --testPathPattern=a11y",
    "test:deck-share": "tsx scripts/test-deck-share-standalone.ts",
    "seed:metadata": "tsx scripts/seed-card-metadata.ts",
    "verify:embeddings": "tsx scripts/verify-embeddings.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/env": "^16.0.7",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.84.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/deno": "^2.3.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dotenv": "^17.2.0",
    "framer-motion": "^12.23.24",
    "fuzzysort": "^3.1.0",
    "lucide-react": "^0.303.0",
    "next": "^16.0.7",
    "next-themes": "^0.2.1",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "recharts": "^3.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@eslint/eslintrc": "^3.3.5",
    "@lhci/cli": "^0.12.0",
    "@next/eslint-plugin-next": "^16.0.7",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/next": "^9.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "pa11y-ci": "^3.1.0",
    "postcss": "^8",
    "start-server-and-test": "^2.1.3",
    "supabase": "^2.30.4",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "wait-on": "^7.2.0"
  }
}
